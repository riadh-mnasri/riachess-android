{
  "expo": {
    "name": "RiaChess",
    "slug": "riachess",
    "scheme": "riachess",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1226",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.riachess.app"
    },
    "android": {
      "package": "fr.riachess.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b1226",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-localization",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "349ab7e7-7b36-4a0f-8786-245e5afc9ac1"
      }
    },
    "owner": "riadhmnasri"
  }
}
